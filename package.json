{
  "name": "weather.forecast",
  "version": "1.0.0",
  "main": "app.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "env TS_NODE_PROJECT=tsconfig.test.json TS_NODE_FILES=true mocha --require ts-node/register --require ./tests/setup.mjs 'tests/**/*.ts'",
    "posttest": "homey app validate",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "npm run format:check && eslint --ext .ts app.ts api.ts drivers lib tests"
  },
  "dependencies": {
    "@balmli/homey-logger": "^1.0.0",
    "feels": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/chai": "^5.2.3",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.0",
    "chai": "^6.2.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
